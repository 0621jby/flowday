# 两个 Supabase 变量都留空 = 保留原有本地 MVP。
# 接入时复制为 .env.local；填写开发项目的 URL 和 Publishable key（或旧 anon key）。
# NEXT_PUBLIC_* 只使用公开 URL 与 Publishable Key。
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# 可选。只用于账户删除的服务端 Supabase secret / 旧 service_role 密钥。
SUPABASE_ACCOUNT_ADMIN_KEY=
APP_ORIGIN=http://127.0.0.1:3100
# 仅用于本机 npm start 的 HTTP 验收。正式 HTTPS 部署不要设置此项。
# FLOWDAY_ALLOW_LOCAL_HTTP=1

# AI 默认使用明确标识的演示模式，不产生外部调用。
AI_PROVIDER=mock
# 云端模式（含 Mock）必须配置至少32个随机字符，所有实例使用相同值。
AI_PROPOSAL_SECRET=
# 真实模式由项目所有者主动启用。仅云端已登录账户可调用。
# AI_PROVIDER=deepseek
AI_ENABLE_PAID_CALLS=false
# 接受供应商 API 根地址或完整 Chat Completions 端点。
# DeepSeek 官方地址为 https://api.deepseek.com，模型 ID 从供应商控制台填写。
AI_API_URL=
AI_API_KEY=
AI_MODEL=
# json_object（默认，含 DeepSeek）、strict 或 plain。
AI_OUTPUT_FORMAT=json_object
# 可选。供应商用 max_completion_tokens 时覆盖默认字段。
# AI_TOKEN_FIELD=max_completion_tokens
# 每次生成最多一次格式重试。可关闭；429、认证失败和网络异常不重试模型。
AI_FORMAT_RETRY=true
# 每百万 Token 的美元单价；不填写时显示“费用未知”，不会当成零成本。
AI_INPUT_USD_PER_MILLION=
AI_OUTPUT_USD_PER_MILLION=
