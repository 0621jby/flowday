[Unit]
Description=Back up FlowDay and record database usage
After=network-online.target
ConditionPathExists=/opt/flowday/runtime.env

[Service]
Type=oneshot
WorkingDirectory=/opt/flowday
EnvironmentFile=/etc/flowday/operations.env
ExecStart=/usr/bin/bash /opt/flowday/maintenance.sh
TimeoutStartSec=30min
