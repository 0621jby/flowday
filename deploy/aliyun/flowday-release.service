[Unit]
Description=Deploy a tested FlowDay image
Requires=docker.service
After=docker.service network-online.target
ConditionPathExists=/opt/flowday/runtime.env

[Service]
Type=oneshot
WorkingDirectory=/opt/flowday
EnvironmentFile=/etc/flowday/operations.env
ExecStart=/usr/bin/bash /opt/flowday/release.sh
TimeoutStartSec=30min
